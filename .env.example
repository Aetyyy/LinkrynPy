# ========================================================
# Linkryn V2 - Environment Configuration Example
# Salin file ini menjadi '.env' dan isi nilainya.
# ========================================================

# Token Bot Discord (Dapatkan dari Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Prefix perintah teks (opsional, selain Slash Commands '/')
COMMAND_PREFIX=,
