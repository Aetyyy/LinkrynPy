# Auto-detect text files and normalize line endings on commit
* text=auto

# Python source files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.example text eol=lf

# Batch and PowerShell scripts (keep CRLF for Windows scripts if any)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
